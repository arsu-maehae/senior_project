{
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(sqlite3 *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(python *)",
      "PowerShell(pytest *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "Bash(python -m pytest *)",
      "PowerShell(python -m pytest *)"
    ],
    "deny": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Edit(./data/incoming/**)",
      "Write(./data/incoming/**)",
      "Edit(./ground_truth/approved/**)",
      "Write(./ground_truth/approved/**)",
      "Edit(./docs/papers/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_unit_tests.py\""
          }
        ]
      }
    ]
  }
}
